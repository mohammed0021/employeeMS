// Prisma 7 schema — AI-Powered Employee Management System (FYP)
// Config: prisma.config.ts supplies the datasource URL (migrations use the
// direct endpoint, DATABASE_URL_MIGRATE, because pooled PgBouncer breaks DDL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  REMOTE
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  FINAL
}

enum FeedbackStatus {
  AI_DRAFT
  DRAFT
  FINALIZED
}

enum PolicyDocStatus {
  PROCESSING
  READY
  FAILED
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
}

enum ChatRole {
  USER
  ASSISTANT
}

enum AiPurpose {
  CHATBOT
  FEEDBACK
}

enum AiCallStatus {
  OK
  ERROR
  TIMEOUT
  RATE_LIMITED
  REFUSED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// ─── Identity & access ──────────────────────────────────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  // scrypt hash (salt embedded). Never serialized to DTOs.
  passwordHash String
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  employeeId   String?    @unique
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  sessions            Session[]
  auditLogs           AuditLog[]
  aiUsageLogs         AiUsageLog[]
  chatConversations   ChatConversation[]
  uploadedPolicies    PolicyDocument[]      @relation("PolicyUploader")
  createdEmployees    Employee[]            @relation("EmployeeCreator")
  recordedAttendance  Attendance[]          @relation("AttendanceRecorder")
  decidedLeave        LeaveRequest[]        @relation("LeaveDecider")
  createdPayroll      PayrollRecord[]       @relation("PayrollCreator")
  finalizedPayroll    PayrollRecord[]       @relation("PayrollFinalizer")
  reviewedFeedback    PerformanceFeedback[] @relation("FeedbackReviewer")
  finalizedFeedback   PerformanceFeedback[] @relation("FeedbackFinalizer")
  updatedAttrition    AttritionIndicator[]  @relation("AttritionIndicatorUpdater")
  createdAttritionRun AttritionSignal[]     @relation("AttritionRunCreator")

  @@index([status])
}

model Session {
  id         String   @id @default(cuid())
  // SHA-256 of the opaque cookie token. The raw token never touches the DB.
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── Core HR ────────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees  Employee[]
  policies   PolicyDocument[]
}

model Employee {
  id            String         @id @default(cuid())
  employeeCode  String         @unique
  firstName     String
  lastName      String
  email         String         @unique
  phone         String?
  position      String
  joinDate      DateTime       @db.Date
  salary        Decimal        @db.Decimal(12, 2)
  status        EmployeeStatus @default(ACTIVE)
  deactivatedAt DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  createdBy User? @relation("EmployeeCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // 1:1 login account (optional — an employee may not have one yet).
  user User?

  // Historical records are Restrict: deactivation, not deletion, is the rule.
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payrollRecords PayrollRecord[]
  feedback       PerformanceFeedback[] @relation("FeedbackSubject")

  attritionSignal   AttritionSignal?
  attritionIndicator AttritionIndicator?

  @@index([departmentId, status])
  @@index([lastName])
}

model Attendance {
  id           String           @id @default(cuid())
  employeeId   String
  date         DateTime         @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  note         String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  recordedBy User?    @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  // Duplicate/conflicting entry detection is a database guarantee.
  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  type           LeaveType
  reason         String
  status         LeaveStatus @default(PENDING)
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?
  cancelledAt    DateTime?
  submittedAt    DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  decidedBy User?    @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status, startDate])
  @@index([startDate, endDate])
}

model PayrollRecord {
  id            String         @id @default(cuid())
  employeeId    String
  month         Int
  year          Int
  baseSalary    Decimal        @db.Decimal(12, 2)
  bonus         Decimal        @default(0) @db.Decimal(12, 2)
  deduction     Decimal        @default(0) @db.Decimal(12, 2)
  grossPay      Decimal        @db.Decimal(12, 2)
  netPay        Decimal        @db.Decimal(12, 2)
  status        PayrollStatus  @default(DRAFT)
  createdById   String?
  finalizedById String?
  finalizedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy  User?    @relation("PayrollCreator", fields: [createdById], references: [id], onDelete: SetNull)
  finalizedBy User?    @relation("PayrollFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)

  // Pay period = (month, year) per employee; FINAL rows are immutable.
  @@unique([employeeId, month, year])
  @@index([year, month])
}

// ─── Performance feedback ───────────────────────────────────────────────────

model PerformanceFeedback {
  id            String         @id @default(cuid())
  employeeId    String
  reviewerId    String
  cycleLabel    String
  // Structured indicators (ratings) supplied by the reviewer — validated by Zod.
  indicators    Json
  aiDraft       String?
  finalText     String?
  status        FeedbackStatus @default(DRAFT)
  aiModel       String?
  generatedAt   DateTime?
  finalizedById String?
  finalizedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  employee    Employee @relation("FeedbackSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer    User     @relation("FeedbackReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  finalizedBy User?    @relation("FeedbackFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
}

// ─── Attrition prediction ───────────────────────────────────────────────────

model AttritionIndicator {
  id                       String   @id @default(cuid())
  employeeId               String   @unique
  overtime                 Boolean  @default(false)
  jobSatisfaction          Int      @default(3)
  workLifeBalance          Int      @default(3)
  environmentSatisfaction  Int      @default(3)
  trainingTimesLastYear    Int      @default(2)
  yearsSinceLastPromotion  Int      @default(0)
  updatedById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  updatedBy User?    @relation("AttritionIndicatorUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AttritionSignal {
  id            String       @id @default(cuid())
  employeeId    String       @unique
  riskScore     Float
  riskCategory  RiskCategory
  // Exact model inputs used for this prediction (non-sensitive subset).
  inputSnapshot Json?
  // Top contributing features from the model.
  topFactors    Json?
  modelName     String?
  modelVersion  String?
  // True when indicators were missing and training-set defaults were imputed.
  partialInputs Boolean      @default(false)
  generatedById String?
  generatedAt   DateTime     @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  generatedBy User?    @relation("AttritionRunCreator", fields: [generatedById], references: [id], onDelete: SetNull)
}

// ─── HR policy documents (RAG source) ───────────────────────────────────────

model PolicyDocument {
  id            String           @id @default(cuid())
  title         String
  fileName      String
  mimeType      String
  sizeBytes     Int
  status        PolicyDocStatus  @default(PROCESSING)
  // Extracted full text kept for re-chunking; chunks are the retrieval unit.
  extractedText String?
  // SHA-256 of file bytes — rejects duplicate uploads.
  contentHash   String           @unique
  chunkCount    Int              @default(0)
  errorMessage  String?
  departmentId  String?
  uploadedById  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  uploadedBy User?       @relation("PolicyUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     PolicyChunk[]

  @@index([status])
}

model PolicyChunk {
  id         String   @id @default(cuid())
  documentId String
  chunkIndex Int
  section    String?
  content    String
  createdAt  DateTime @default(now())

  document PolicyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Full-text search uses an expression GIN index created by raw SQL migration
  // (see prisma/migrations): to_tsvector('english', content).
  @@unique([documentId, chunkIndex])
}

// ─── Chatbot ────────────────────────────────────────────────────────────────

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String
  // [{documentId, documentTitle, chunkId, section}] for source-aware answers.
  sources        Json?
  model          String?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── AI observability (metadata only — never prompt/completion content) ─────

model AiUsageLog {
  id        String       @id @default(cuid())
  actorId   String?
  purpose   AiPurpose
  provider  String
  model     String
  status    AiCallStatus
  latencyMs Int?
  tokensIn  Int?
  tokensOut Int?
  errorCode String?
  createdAt DateTime     @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([purpose, createdAt])
  // Supports the per-user daily AI quota query.
  @@index([actorId, createdAt])
}

// ─── Audit (append-only; no update/delete code path exists) ─────────────────

model AuditLog {
  id         String        @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  outcome    AuditOutcome  @default(SUCCESS)
  // Whitelisted, non-sensitive metadata only (never passwords/tokens/keys).
  metadata   Json?
  createdAt  DateTime      @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ─── Rate limiting (DB-backed fixed windows survive serverless instances) ───

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt
}
