# ── Database (Neon) ──────────────────────────────────────────────────────────
# Prefixed with EMS_ so this repo's .env stays authoritative even when a stale
# machine-level DATABASE_URL exists (Next.js and dotenv never override vars
# already in process.env, so an ambient DATABASE_URL would silently win).
# The code falls back to the unprefixed names, so on Vercel/Neon Functions —
# which inject DATABASE_URL — nothing needs renaming. See src/lib/db-url.ts.
# Pooled connection string (PgBouncer, hostname contains `-pooler`) — used by
# the app at runtime. Provided by `neon deploy` / `neon env pull`.
EMS_DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/dbname?sslmode=require"
# Direct (non-pooled) connection string — used by `prisma migrate` only,
# because pooled connections break DDL transaction handling.
EMS_DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Branch this environment is pinned to (set by the Neon CLI).
NEON_BRANCH="production"
# Separate database for integration tests (a Neon branch or second DB).
# Point this at a disposable Neon branch, never production.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/test_dbname?sslmode=require"

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin, used for CSRF origin checks and links.
APP_URL="http://localhost:3000"
# Set to 1 only for demo/seed data (never in production).
SEED_DEMO="0"
# Bootstrap admin used by `npm run create-admin`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# ── AI (OpenRouter) ──────────────────────────────────────────────────────────
# Server-only. NEVER prefix with NEXT_PUBLIC_.
AI_PROVIDER="openrouter"
# Free-model IDs rotate without notice — verify current :free models and
# update this value without code changes. Candidates change frequently.
AI_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_MAX_INPUT_TOKENS="6000"
AI_MAX_OUTPUT_TOKENS="700"
AI_TIMEOUT_MS="25000"
# Single attempt on 429/5xx — never retry storms against free quota.
AI_MAX_ATTEMPTS="1"
# Per-user app-level daily budget counted from the ai_usage_log table.
AI_DAILY_USER_LIMIT="40"
# 1 = deterministic mock provider (tests/dev, zero network, zero quota).
AI_MOCK="0"
